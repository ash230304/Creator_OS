# ══════════════════════════════════════════════════════
# CreatorOS — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.
# ══════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────
# Local dev defaults (matches docker-compose.yml):
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/creatoros
SPRING_DATASOURCE_USERNAME=creatoros
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_LOCAL_DATABASE_PASSWORD

# ── JWT ───────────────────────────────────────────────
# Generate at least 32 random bytes for the HS256 signing key:
#   openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET

# ── AI Provider ───────────────────────────────────────
# Set to "openai" or "groq"
AI_PROVIDER=groq

# OpenAI (required if AI_PROVIDER=openai)
OPENAI_API_KEY=sk-proj-...

# Groq (required if AI_PROVIDER=groq or WHISPER_PROVIDER=groq — free tier available)
GROQ_API_KEY=gsk_...

# ── Whisper (transcription) ───────────────────────────
# Set to "openai", "groq", or "local"
WHISPER_PROVIDER=groq

# ── Storage ───────────────────────────────────────────
STORAGE_LOCAL_PATH=./uploads

# ── Frontend (for CORS on backend) ───────────────────
# Set to your Vercel URL in production:
FRONTEND_URL=http://localhost:3000

# ── Frontend API URL (Next.js env var) ───────────────
# Set to your Railway backend URL in production:
NEXT_PUBLIC_API_URL=http://localhost:8080
